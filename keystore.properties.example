# Release signing for local builds. Copy to keystore.properties (git-ignored) in the project root
# and fill in. storeFile is absolute or relative to the project root; keep the .jks outside the
# repository if you can. CI uses the LOCALCAST_* environment variables instead (docs/RELEASING.md).
# Without this file (and without those variables) release APKs are signed with the debug key.
storeFile=
storePassword=
keyAlias=
keyPassword=
